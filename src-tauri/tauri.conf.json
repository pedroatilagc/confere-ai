{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ConfereAí",
  "version": "0.1.0",
  "identifier": "com.confereai.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ConfereAí",
        "width": 900,
        "height": 650,
        "minWidth": 520,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#191919"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
